# Copy to .env.prod (repo root) on the server and fill in real values.
# Generate secrets with: openssl rand -hex 32
# Run compose with: docker compose --env-file .env.prod -f docker-compose.prod.yml ...

# Public address of the site, no trailing slash.
# Use http://<droplet-ip> until a domain is set up, then https://yourdomain.
# Changing this requires rebuilding the frontend (see DEPLOY.md).
PUBLIC_URL=http://YOUR_DROPLET_IP

# --- Postgres (internal to the server, never exposed publicly) ---
DB_USERNAME=hcg
DB_PASSWORD=change-me-to-a-long-random-password
DB_NAME=hcg_db

# --- Auth ---
AUTH_JWT_SECRET=change-me-to-a-long-random-secret
AUTH_JWT_EXPIRES_IN_SECONDS=86400

# --- First CMS admin (used by: docker compose exec backend pnpm run seed:prod) ---
SEED_ADMIN_FULL_NAME=HCG Admin
SEED_ADMIN_EMAIL=admin@hcgfoundation.org
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-strong-password

# --- Backend <-> AI service shared secret ---
AI_SERVICE_INTERNAL_KEY=change-me-to-a-long-random-secret

# --- Cloudflare R2 ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_REGION=auto

# --- Razorpay (required: the backend will not start without a key) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Resend (donation emails) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- OpenAI (chatbot) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Frontend (optional) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
