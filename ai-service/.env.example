# --- App ---
PORT=8001

# --- Postgres (same DB as NestJS; pgvector stores embeddings here) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=hcg_db

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval (old-bot quality defaults) ---
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=15
SIMILARITY_THRESHOLD=0.35
MAX_SOURCES=3
SOURCE_SCORE_MARGIN=0.05
CONVERSATION_MEMORY_SIZE=6
OPENAI_TIMEOUT_SECONDS=30

# --- Knowledge ---
KNOWLEDGE_DIR=./knowledge/public
GEEKONOMY_DOCS_DIR=./knowledge/source-docs

# --- Security: same value as NestJS AI_SERVICE_INTERNAL_KEY ---
INTERNAL_API_KEY=replace-with-a-long-random-secret
