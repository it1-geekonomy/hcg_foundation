# --- App ---
PORT=8001

# --- Postgres + pgvector (embeddings store only) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=hcg_vectors

# --- Groq (OpenAI-compatible chat) ---
OPENAI_API_KEY=gsk_your_groq_key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=llama-3.3-70b-versatile

# --- Local embeddings (Groq does not provide embeddings) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_CHUNKS=3
CONTEXT_EXCERPT_CHARS=450
MAX_RETRIEVAL_DISTANCE=0.72
CHAT_MAX_TOKENS=220

# Answer cache — skip Groq on repeat / near-duplicate questions
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=3600
ANSWER_CACHE_MAX_ENTRIES=500
ANSWER_CACHE_SEMANTIC=true
ANSWER_CACHE_SIMILARITY_THRESHOLD=0.92

INTERNAL_API_KEY=replace-with-a-long-random-secret
