# --- App ---
PORT=8001

# --- Postgres (same instance/DB as your NestJS backend, different table) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_db

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o-mini

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K_CHUNKS=4

# --- Security: shared secret between NestJS and this service ---
# Generate a strong random value, e.g.: openssl rand -hex 32
INTERNAL_API_KEY=replace-with-a-long-random-secret
