# App
NODE_ENV=development
PORT=6060

# Postgres (Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=hcg_db

# Set to true only for local/dev quick start (auto creates tables).
# Keep false once you use migrations.
DB_SYNCHRONIZE=false

AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_INTERNAL_KEY=replace-with-a-long-random-secret

# Cloudflare R2 (public CDN URLs stored on content rows)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_REGION=auto

# Razorpay (website Donate Now)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
