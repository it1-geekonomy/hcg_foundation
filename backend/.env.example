# App
NODE_ENV=development
PORT=6060

# Postgres (Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_db

# Set to true only for local/dev quick start (auto creates tables).
# Keep false once you use migrations.
DB_SYNCHRONIZE=false

AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_INTERNAL_KEY=replace-with-a-long-random-secret
