# App
NODE_ENV=development
PORT=6060

# Legacy CMS MySQL (from backend/DB-Local — for testing)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=hcg
DB_PASSWORD=hcg
DB_NAME=hcgfoundation
DB_SYNCHRONIZE=false

# AI service bridge
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_INTERNAL_KEY=replace-with-a-long-random-secret
# On boot, push all SOURCE_TABLES rows to ai-service (useful for first-time testing)
CHATBOT_AUTO_REINDEX=false

# Legacy CMS public media base (images / annual report PDFs)
CMS_MEDIA_BASE_URL=https://www.hcgfoundation.org/assets/uploads

# Docker MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=hcgfoundation
MYSQL_USER=hcg
MYSQL_PASSWORD=hcg
MYSQL_PORT=3306

# Vector DB for ai-service
VECTOR_DB_USERNAME=postgres
VECTOR_DB_PASSWORD=postgres
VECTOR_DB_NAME=hcg_vectors
VECTOR_DB_PORT=5432
